{{define "view"}}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebCatch - Captured HTTP Calls</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Courier New', 'Monaco', 'Consolas', monospace;
            background: #ffffff;
            color: #000000;
            padding: 20px;
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        h1 {
            color: #000000;
            margin-bottom: 20px;
            font-size: 1.5em;
            font-weight: normal;
        }

        h1:before {
            content: "$ ";
        }

        h2 {
            color: #000000;
            margin-bottom: 15px;
            font-size: 1.2em;
            font-weight: normal;
            margin-top: 20px;
        }

        h2:before {
            content: "# ";
        }

        .btn {
            background: #ffffff;
            color: #000000;
            border: 1px solid #000000;
            border-radius: 6px;
            padding: 8px 16px;
            cursor: pointer;
            font-size: 0.9em;
            font-family: 'Courier New', monospace;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover {
            background: #000000;
            color: #ffffff;
        }

        .call-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .call-card {
            border: 1px solid #000000;
            border-radius: 8px;
            overflow: hidden;
        }

        .call-header {
            padding: 8px 12px;
            border-bottom: 1px solid #000000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .call-method {
            display: inline-block;
            padding: 2px 6px;
            border: 1px solid #000000;
            border-radius: 4px;
            font-weight: normal;
            font-size: 0.85em;
        }

        .call-path {
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            color: #000000;
            flex: 1;
            min-width: 200px;
        }

        .call-time {
            color: #666666;
            font-size: 0.85em;
        }

        .new-badge {
            background: none;
            border: none;
            padding: 0;
            color: #000000;
            font-weight: bold;
            font-size: 0.85em;
            font-family: 'Courier New', monospace;
            cursor: pointer;
        }

        .new-badge:hover {
            text-decoration: underline;
        }

        .call-body {
            padding: 10px 12px;
        }

        .call-section {
            margin-bottom: 10px;
        }

        .call-section:last-child {
            margin-bottom: 0;
        }

        .section-title {
            font-weight: normal;
            color: #000000;
            margin-bottom: 6px;
            font-size: 0.85em;
        }

        .section-title:before {
            content: "# ";
        }

        .headers-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85em;
        }

        .headers-table tr {
            border-bottom: 1px solid #e0e0e0;
        }

        .headers-table tr:last-child {
            border-bottom: none;
        }

        .headers-table td {
            padding: 4px 0;
        }

        .headers-table td:first-child {
            font-weight: normal;
            color: #000000;
            width: 200px;
            font-family: 'Courier New', monospace;
            font-size: 0.85em;
        }

        .headers-table td:first-child:after {
            content: ":";
            margin-left: 2px;
        }

        .headers-table td:last-child {
            color: #333333;
            word-break: break-all;
        }

        .body-content {
            background: #f5f5f5;
            padding: 8px;
            border: 1px solid #000000;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 0.85em;
            white-space: pre-wrap;
            word-break: break-all;
            color: #000000;
            max-height: 300px;
            overflow-y: auto;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            border: 1px solid #000000;
            border-radius: 8px;
        }

        .empty-state svg {
            width: 64px;
            height: 64px;
            margin-bottom: 20px;
            opacity: 0.3;
            stroke: #000000;
        }

        .empty-state h2 {
            color: #000000;
            margin-bottom: 10px;
            font-size: 1em;
            font-weight: normal;
        }

        .empty-state p {
            color: #666666;
            font-size: 0.9em;
        }
    </style>
</head>
<body sse-connect="/events">
    <div class="container">
        <h1>webcatch</h1>

        {{template "page-content" .}}

        <script src="/static/js/htmx.min.js"></script>
        <script src="/static/js/hx-sse.min.js"></script>
    </div>
</body>
</html>
{{end}}

{{define "call-card"}}<div class="call-card">
    <div class="call-header">
        <div style="display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0;">
            <span class="call-method">{{.Method}}</span>
            <span class="call-path">{{.Path}}</span>
        </div>
        {{if not .Viewed}}<button class="new-badge" title="Mark as viewed" hx-post="/calls/{{.ID}}/viewed" hx-target="closest .call-card" hx-swap="outerHTML">[ new ]</button>{{end}}
        <span class="call-time">{{.Timestamp.Format "2006-01-02 15:04:05"}}</span>
    </div>
    <div class="call-body">
        {{if .Headers}}
        <div class="call-section">
            <div class="section-title">headers</div>
            <table class="headers-table">
                {{range $key, $values := .Headers}}
                <tr>
                    <td>{{$key}}</td>
                    <td>{{index $values 0}}</td>
                </tr>
                {{end}}
            </table>
        </div>
        {{end}}

        {{if .Body}}
        <div class="call-section">
            <div class="section-title">
                body
                {{if .IsJSON}}<button class="btn json-beautify-btn" style="margin-left: 10px; padding: 2px 8px; font-size: 0.75em;" hx-post="{{if .Beautified}}/calls/{{.ID}}/minify{{else}}/calls/{{.ID}}/beautify{{end}}" hx-target="closest .call-card" hx-swap="outerHTML">[ {{if .Beautified}}minify{{else}}beautify{{end}} json ]</button>{{end}}
            </div>
            <div class="body-content">{{.DisplayBody}}</div>
        </div>
        {{end}}
    </div>
</div>{{end}}

{{define "content"}}{{if .}}
    <div class="call-list">
        {{range .}}{{template "call-card" .}}{{end}}
    </div>
{{else}}
    <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
        </svg>
        <h2>no calls captured</h2>
        <p>send requests to http://localhost:8080/ to see them here</p>
    </div>
{{end}}{{end}}

{{define "page-content"}}<div id="content" hx-get="/" hx-select="#content" hx-target="#content" hx-swap="outerHTML" hx-trigger="new-call from:body"><div style="display: flex; justify-content: flex-end; gap: 10px; margin-bottom: 20px;">{{if .Calls}}<button class="btn" hx-get="{{if eq .Sort "asc"}}/?sort=desc{{else}}/?sort=asc{{end}}" hx-target="#content" hx-select="#content" hx-swap="outerHTML" hx-push-url="true">[ sort: {{if eq .Sort "asc"}}oldest first{{else}}newest first{{end}} ]</button>{{end}}<button class="btn" hx-post="/clear" hx-target="#content" hx-swap="outerHTML">[ clear ]</button></div>{{template "content" .Calls}}</div>{{end}}
